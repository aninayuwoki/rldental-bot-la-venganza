# Configuración del Sistema RLDental
# Copia este archivo como .env si deseas usar variables de entorno

# Puerto del servidor (por defecto 3001)
PORT=3001

# Número de WhatsApp del administrador (sin + ni espacios)
# Ejemplo: Si tu número es +593 97 871 9532, pon: 593978719532
ADMIN_NUMBER=593978719532

# Número de negocio (para que los clientes te contacten)
BUSINESS_PHONE=593978719532

# Nivel de logs (silent, error, warn, info, debug)
LOG_LEVEL=info
